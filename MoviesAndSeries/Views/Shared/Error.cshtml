@model MoviesAndSeries.Models.ErrorViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Movies &amp; Series — Error</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="nav container" aria-label="Main navigation">
            <a class="brand" href="@Url.Action("Index", "Home")">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect x="4.5" y="5.5" width="15" height="13" rx="3" stroke="currentColor" stroke-width="1.7"></rect>
                        <path d="m10 9 5 3-5 3V9Z" fill="currentColor"></path>
                    </svg>
                </span>
                <span>Movies &amp; Series</span>
            </a>
        </nav>
    </header>

    <main class="container">
        <section class="page-head glass error-card">
            <div>
                <p class="eyebrow">Unexpected Error</p>
                <h1>Something went wrong</h1>
                <p class="page-copy">
                    An unexpected error occurred while processing your request.
                    Return to the home page and try again.
                </p>

                @if (Model.ShowRequestId)
                {
                    <p class="page-copy request-id-copy">
                        Request ID: <strong>@Model.RequestId</strong>
                    </p>
                }
            </div>

            <a class="pdf-button" href="@Url.Action("Index", "Home")">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
                <span>Back to Home</span>
            </a>
        </section>
    </main>
</body>
</html>
