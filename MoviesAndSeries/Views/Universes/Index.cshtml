@using System.Globalization
@model MoviesAndSeries.ViewModels.Universes.UniverseIndexViewModel

@{
    Layout = null;

    var linkedContentCount = Model.Universes.Sum(universe => universe.ContentCount);
    var linkedMovieCount = Model.Universes.Sum(universe => universe.MovieCount);
    var linkedSeriesCount = Model.Universes.Sum(universe => universe.SeriesCount);

    string GetInitials(string name)
    {
        var initials = string.Concat(
            name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Take(2)
                .Select(word => word[0]));

        return string.IsNullOrWhiteSpace(initials)
            ? "UN"
            : initials.ToUpper(CultureInfo.InvariantCulture);
    }
}

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>Movies &amp; Series — Universes</title>
    <script src="~/js/theme-init.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/universes.css" asp-append-version="true" />
</head>
<body data-get-universe-url="@Url.Action("GetUniverse", "Universes")"
      data-get-details-url="@Url.Action("GetDetails", "Universes")"
      data-create-universe-url="@Url.Action("Create", "Universes")"
      data-update-universe-url="@Url.Action("Update", "Universes")"
      data-delete-universe-url="@Url.Action("Delete", "Universes")"
      data-move-content-url="@Url.Action("MoveContent", "Universes")"
      data-reorder-content-url="@Url.Action("Reorder", "Universes")"
      data-remove-content-url="@Url.Action("RemoveContent", "Universes")"
      data-delete-content-url="@Url.Action("DeleteContent", "Universes")">

    <header class="topbar">
        <nav class="nav container" aria-label="Main navigation">
            <a class="brand" href="@Url.Action("Index", "Home")" aria-label="Movies and Series home">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                        <rect x="4.5" y="5.5" width="15" height="13" rx="3" stroke="currentColor" stroke-width="1.7"></rect>
                        <path d="m10 9 5 3-5 3V9Z" fill="currentColor"></path>
                    </svg>
                </span>
                <span>Movies &amp; Series</span>
            </a>

            <div class="nav-links">
                <a class="nav-link" href="@Url.Action("Index", "Home")">Home</a>
                <a class="nav-link" href="@Url.Action("Index", "Management")">Management</a>
                <a class="nav-link active" href="@Url.Action("Index", "Universes")" aria-current="page">Universes</a>
            </div>

            <button class="theme-toggle"
                    id="themeToggle"
                    type="button"
                    aria-label="Switch to light mode"
                    title="Toggle theme">
                <svg class="moon-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"
                          stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path>
                </svg>
                <svg class="sun-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="3.7" stroke="currentColor" stroke-width="1.7"></circle>
                    <path d="M12 2.5V5M12 19v2.5M21.5 12H19M5 12H2.5M18.7 5.3l-1.8 1.8M7.1 16.9l-1.8 1.8M18.7 18.7l-1.8-1.8M7.1 7.1 5.3 5.3"
                          stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                </svg>
                <span class="sr-only" id="themeLabel">Light mode</span>
            </button>
        </nav>
    </header>

    <main class="container">
        <section id="universeListView">
            <section class="page-head glass" aria-labelledby="pageTitle">
                <div>
                    <p class="eyebrow">Universe Management</p>
                    <h1 id="pageTitle">Viewing universes</h1>
                    <p class="page-copy">
                        Organize interconnected movies and series in your own custom watch order.
                    </p>
                </div>

                <button class="primary-button" id="createUniverseButton" type="button">
                    <svg class="button-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
                    </svg>
                    New Universe
                </button>
            </section>

            <section class="summary glass" aria-label="Universe summary">
                <div class="summary-item">
                    <span class="summary-label">Universes</span>
                    <strong class="summary-value" id="overviewUniverseCount">@Model.Universes.Count</strong>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Linked Titles</span>
                    <strong class="summary-value" id="overviewContentCount">@linkedContentCount</strong>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Movies</span>
                    <strong class="summary-value" id="overviewMovieCount">@linkedMovieCount</strong>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Series</span>
                    <strong class="summary-value" id="overviewSeriesCount">@linkedSeriesCount</strong>
                </div>
            </section>

            <section class="toolbar glass" aria-label="Universe search">
                <label class="search-wrap">
                    <span class="sr-only">Search universes</span>
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"></circle>
                        <path d="m16 16 4.3 4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                    <input class="search-input"
                           id="universeSearch"
                           type="search"
                           placeholder="Search universes..."
                           autocomplete="off" />
                    <button class="clear-search" id="clearUniverseSearch" type="button" aria-label="Clear search" hidden>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
                        </svg>
                    </button>
                </label>

                <span class="result-label" id="universeResultLabel" aria-live="polite"></span>
            </section>

            <div class="section-header">
                <h2 class="section-title">All universes</h2>

                <div class="section-controls">
                    <span class="result-label">Select a card to open its watch order</span>

                    <label class="select-wrap sort-select-wrap">
                        <span class="sr-only">Universe sort order</span>
                        <select class="select-input sort-select" id="universeSortSelect" aria-label="Universe sort order">
                            <option value="az" selected>A to Z</option>
                            <option value="newest">Newest First</option>
                        </select>
                        <svg class="chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                            <path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                    </label>
                </div>
            </div>

            <div class="universe-grid" id="universeGrid">
                @foreach (var universe in Model.Universes)
                {
                    var createdAtMs = new DateTimeOffset(
                        DateTime.SpecifyKind(universe.CreatedAtUtc, DateTimeKind.Utc))
                        .ToUnixTimeMilliseconds();

                    <article class="universe-card"
                             style="--universe-color: @universe.ColorHex"
                             data-universe-card
                             data-universe-id="@universe.Id"
                             data-universe-name="@universe.Name"
                             data-created-at="@createdAtMs"
                             data-content-count="@universe.ContentCount"
                             data-movie-count="@universe.MovieCount"
                             data-series-count="@universe.SeriesCount"
                             role="button"
                             tabindex="0"
                             aria-label="Open @universe.Name">

                        <div class="card-top">
                            <span class="universe-mark" data-card-mark>@GetInitials(universe.Name)</span>

                            <button class="card-menu-button"
                                    id="universeMenuButton@(universe.Id)"
                                    type="button"
                                    data-universe-menu="@universe.Id"
                                    aria-label="Actions for @universe.Name"
                                    aria-haspopup="menu"
                                    aria-expanded="false">
                                •••
                            </button>
                        </div>

                        <h3 data-card-name>@universe.Name</h3>
                        <p class="card-description">Open and organize your watch order.</p>

                        <div class="card-stats">
                            <div class="card-stat">
                                <strong data-card-total>@universe.ContentCount</strong>
                                <span>Titles</span>
                            </div>
                            <div class="card-stat">
                                <strong data-card-movies>@universe.MovieCount</strong>
                                <span>Movies</span>
                            </div>
                            <div class="card-stat">
                                <strong data-card-series>@universe.SeriesCount</strong>
                                <span>Series</span>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="empty-state glass" id="universeEmptyState" hidden>
                <div class="empty-icon" aria-hidden="true">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                        <circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"></circle>
                        <path d="m15.5 15.5 4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                    </svg>
                </div>
                <h2 id="universeEmptyTitle">No universes yet</h2>
                <p id="universeEmptyCopy">Create your first viewing universe to get started.</p>
            </div>
        </section>

        <section id="universeDetailView" style="--active-universe-color: #8491FF" hidden>
            <section class="detail-head glass">
                <button class="back-button" id="detailBackButton" type="button">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
                        <path d="m14.5 6-6 6 6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                    All Universes
                </button>

                <div class="detail-head-top">
                    <div class="detail-identity">
                        <span class="detail-mark" id="detailMark">UN</span>
                        <div>
                            <p class="eyebrow">Watch Order</p>
                            <h1 id="detailTitle">Universe</h1>
                            <p class="page-copy" id="detailSubtitle"></p>
                        </div>
                    </div>

                    <div class="detail-actions">
                        <button class="secondary-button" id="detailEditButton" type="button">
                            <svg class="button-icon" viewBox="0 0 24 24" fill="none">
                                <path d="m5 16-.7 3.7L8 19l9.8-9.8-3-3L5 16ZM13.8 7.2l3 3"
                                      stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                            </svg>
                            Edit Universe
                        </button>

                        <button class="danger-button" id="detailDeleteButton" type="button">
                            Delete Universe
                        </button>
                    </div>
                </div>

                <div class="detail-summary">
                    <div class="detail-stat">
                        <strong id="detailTotalCount">0</strong>
                        <span>Total Titles</span>
                    </div>
                    <div class="detail-stat">
                        <strong id="detailMovieCount">0</strong>
                        <span>Movies</span>
                    </div>
                    <div class="detail-stat">
                        <strong id="detailSeriesCount">0</strong>
                        <span>Series</span>
                    </div>
                </div>
            </section>

            <section class="toolbar glass" aria-label="Search and filter universe titles">
                <label class="search-wrap">
                    <span class="sr-only">Search within this universe</span>
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none">
                        <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.8"></circle>
                        <path d="m16 16 4.3 4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                    </svg>
                    <input class="search-input"
                           id="detailSearch"
                           type="search"
                           placeholder="Search in this universe..."
                           autocomplete="off" />
                    <button class="clear-search" id="clearDetailSearch" type="button" aria-label="Clear search" hidden>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none">
                            <path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
                        </svg>
                    </button>
                </label>

                <div class="filter-group" role="group" aria-label="Content type">
                    <button class="filter-button active" type="button" data-detail-filter="all">All</button>
                    <button class="filter-button" type="button" data-detail-filter="movie">Movies</button>
                    <button class="filter-button" type="button" data-detail-filter="series">Series</button>
                </div>
            </section>

            <div class="section-header">
                <h2 class="section-title">Watch list</h2>
                <span class="result-label" id="detailResultLabel" aria-live="polite"></span>
            </div>

            <div class="ordering-note" id="orderingNote">
                <svg viewBox="0 0 24 24" fill="none">
                    <path d="M8 6h11M8 12h11M8 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01"
                          stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                </svg>
                <div>
                    <strong>Custom watch order.</strong>
                    <small>Drag rows to reorder or pick an exact position from the row menu.</small>
                </div>
            </div>

            <div class="order-list" id="orderList"></div>

            <div class="empty-state glass" id="detailEmptyState" hidden>
                <div class="empty-icon" aria-hidden="true">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                        <path d="M6 8.5h12M6 12h12M6 15.5h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
                    </svg>
                </div>
                <h2 id="detailEmptyTitle">No titles in this universe</h2>
                <p id="detailEmptyCopy">Assign movies or series to this universe from the Management page.</p>
            </div>
        </section>

        <footer class="footer">
            <span>Personal Movie &amp; Series Tracker</span>
            <span>Universes</span>
        </footer>
    </main>

    <div class="context-menu" id="contextMenu" role="menu" hidden></div>

    <div class="drawer-backdrop" id="drawerBackdrop" hidden>
        <aside class="drawer" id="universeDrawer" role="dialog" aria-modal="true" aria-labelledby="drawerTitle" hidden>
            <div class="drawer-header">
                <div>
                    <p class="drawer-kicker" id="drawerEyebrow">NEW UNIVERSE</p>
                    <h2 class="drawer-title" id="drawerTitle">Create a viewing universe</h2>
                    <p class="drawer-copy">Choose a universe name and accent color.</p>
                </div>

                <button class="icon-button" type="button" data-close-drawer aria-label="Close panel">
                    <svg viewBox="0 0 24 24" fill="none">
                        <path d="m7 7 10 10M17 7 7 17" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"></path>
                    </svg>
                </button>
            </div>

            <form class="universe-form" id="universeForm" novalidate>
                @Html.AntiForgeryToken()
                <input id="universeIdInput" type="hidden" />

                <div class="drawer-body">
                    <div class="field">
                        <label class="field-label" for="universeNameInput">Universe name</label>
                        <input class="text-input"
                               id="universeNameInput"
                               type="text"
                               maxlength="100"
                               placeholder="e.g. Marvel Cinematic Universe"
                               autocomplete="off"
                               required />
                    </div>

                    <div class="field">
                        <label class="field-label" for="hexColorInput">Universe color</label>
                        <div class="color-editor">
                            <div class="color-picker-shell" id="colorPickerShell">
                                <input class="color-picker"
                                       id="colorPickerInput"
                                       type="color"
                                       value="#8B5CF6"
                                       aria-label="Color picker" />
                                <svg class="color-picker-icon" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 20a8 8 0 1 0-8-8c0 2.2 1.8 4 4 4h1.1c.8 0 1.4.8 1.1 1.5-.5 1.2.4 2.5 1.8 2.5Z"
                                          stroke="currentColor" stroke-width="1.7"></path>
                                    <circle cx="8" cy="10" r="1" fill="currentColor"></circle>
                                    <circle cx="11" cy="7.5" r="1" fill="currentColor"></circle>
                                    <circle cx="15" cy="8.5" r="1" fill="currentColor"></circle>
                                </svg>
                            </div>

                            <input class="text-input"
                                   id="hexColorInput"
                                   type="text"
                                   maxlength="7"
                                   value="#8B5CF6"
                                   placeholder="#8B5CF6"
                                   autocomplete="off" />
                        </div>

                        <p class="field-help">Click the swatch or enter a #RRGGBB hex code manually.</p>
                        <div class="color-presets" id="colorPresets" aria-label="Preset colors"></div>
                    </div>

                    <div class="universe-preview" id="previewCard" style="--preview-color: #8B5CF6">
                        <p class="preview-label">Live Preview</p>
                        <div class="preview-content">
                            <span class="preview-mark" id="previewMark">NU</span>
                            <p class="preview-name" id="previewName">New universe</p>
                        </div>
                    </div>
                </div>

                <div class="drawer-footer">
                    <button class="secondary-button" type="button" data-close-drawer>Cancel</button>
                    <button class="primary-button" id="drawerSaveButton" type="submit">Create Universe</button>
                </div>
            </form>
        </aside>
    </div>

    <div class="modal-backdrop" id="moveModal" hidden>
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="moveTitle">
            <div class="modal-icon" aria-hidden="true">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                    <path d="M12 4v16M8.5 7.5 12 4l3.5 3.5M8.5 16.5 12 20l3.5-3.5"
                          stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </div>
            <h2 id="moveTitle">Move to position</h2>
            <p id="moveCopy"></p>

            <div class="modal-field">
                <label class="field-label" for="movePosition">New position</label>
                <div class="select-wrap">
                    <select class="select-input" id="movePosition"></select>
                    <svg class="chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m7 9.5 5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </div>
            </div>

            <div class="modal-actions">
                <button class="secondary-button" type="button" data-close-move>Cancel</button>
                <button class="primary-button" id="moveSubmitButton" type="button">Move</button>
            </div>
        </section>
    </div>

    <div class="modal-backdrop" id="confirmModal" hidden>
        <section class="modal-card" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
            <div class="modal-icon danger" aria-hidden="true">
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none">
                    <path d="M5.5 7.5h13M9.5 4.5h5M8 7.5l.7 11h6.6l.7-11M10 10.5v5M14 10.5v5"
                          stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
            </div>
            <h2 id="confirmTitle">Confirm action</h2>
            <p id="confirmCopy"></p>

            <div class="modal-actions">
                <button class="secondary-button" type="button" data-close-confirm>Cancel</button>
                <button class="danger-button" id="confirmButton" type="button">Confirm</button>
            </div>
        </section>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite" hidden>
        <span id="toastMessage"></span>
    </div>

    <script src="~/js/universes.js" asp-append-version="true"></script>
</body>
</html>
